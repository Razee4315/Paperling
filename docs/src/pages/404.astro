---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import { url } from "../lib/site";
import { mascotCrumpled } from "../lib/art";
---

<Base
  title="Page not found | Paperling"
  description="This page seems to have slipped out of the notebook. Find your way back to Paperling."
  path="404.html"
  noindex
>
  <div class="wrap section">
    <Image
      class="lost-mascot"
      src={mascotCrumpled}
      alt="Paperling's mascot, crumpled into a dizzy paper ball"
      widths={[180, 360]}
      sizes="180px"
      loading="eager"
    />
    <h1>
      This page
      <br />
      wandered off.
    </h1>
    <p style="margin-top:25px">
      The rest of the notebook is right where you left it.
    </p>
    <div class="actions">
      <a class="button" href={url()}>
        Back to Paperling ↗
      </a>
      <a class="text-link" href={url("guide/")}>
        Open the guide
      </a>
    </div>
  </div>
</Base>
