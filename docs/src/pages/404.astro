---
import Base from "../layouts/Base.astro";
import { url } from "../lib/site";
---

<Base
  title="Page not found | Paperling"
  description="This page seems to have slipped out of the notebook. Find your way back to Paperling."
  path="404.html"
  noindex
>
  <div class="wrap section">
    <p class="eyebrow">404 / A LOOSE SHEET</p>
    <h1>
      This page
      <br />
      wandered off.
    </h1>
    <p style="margin-top:25px">
      The rest of the notebook is right where you left it.
    </p>
    <div class="actions">
      <a class="button" href={url()}>
        Back to Paperling ↗
      </a>
      <a class="text-link" href={url("guide/")}>
        Open the guide
      </a>
    </div>
  </div>
</Base>
