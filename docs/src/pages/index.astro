---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import CTA from "../components/CTA.astro";
import Hero from "../components/Hero.astro";
import { url, absolute, SITE, faqs } from "../lib/site";
import paper from "../assets/screenshots/reader-paper.png";
import light from "../assets/screenshots/reader-light.png";
import showcase from "../assets/screenshots/showcase-dark.png";
import { featureIcons, toolkit, mascotPaint } from "../lib/art";
// WEB-05: split view leads the hero now, so the tabs below start on the themes.
const views = [
  {
    name: "Paper theme",
    image: paper,
    caption: "A warm, quiet page for a longer read.",
    alt: "Paperling Reader view in the warm Paper theme",
  },
  {
    name: "Light theme",
    image: light,
    caption: "A bright canvas for your next document.",
    alt: "Paperling Reader view in the Light theme",
  },
  {
    name: "Math & diagrams",
    image: showcase,
    caption: "Equations and diagrams, right in your document.",
    alt: "Paperling displaying a mathematical equation and a Mermaid flowchart beside their Markdown source",
  },
];
const schema = [
  {
    "@type": "SoftwareApplication",
    name: "Paperling",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Windows, macOS, Linux, Android",
    url: absolute(),
    downloadUrl: SITE.releases,
    license: SITE.repo + "/blob/main/LICENSE",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description:
      "A free, open-source Markdown reader and editor with live preview, math, diagrams, and optional AI.",
  },
];
---

<Base schema={schema}>
  <Hero />
  <section class="section showcase-section wrap" id="editor">
    <div class="section-heading" data-reveal>
      <div>
        <h2>
          One file.
          <br />
          <em>Read it your way.</em>
        </h2>
      </div>
      <p>A warm page, a bright one, or math and diagrams in place.</p>
    </div>
    <div id="themes" data-showcase data-reveal>
      <div
        class="view-switcher"
        role="tablist"
        aria-label="Explore Paperling views"
      >
        {views.map((v, i) => (
          <button
            role="tab"
            id={"view-tab-" + i}
            aria-controls={"view-panel-" + i}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-view-tab={i}
          >
            {v.name}
          </button>
        ))}
      </div>
      {views.map((v, i) => (
        <div
          id={"view-panel-" + i}
          role="tabpanel"
          aria-labelledby={"view-tab-" + i}
          tabindex="0"
          hidden={i !== 0}
          data-view-panel={i}
        >
          <figure>
            <div class="screenshot-frame">
              <Image
                src={v.image}
                alt={v.alt}
                widths={[640, 960, 1280, 1600]}
                sizes="(max-width: 720px) 94vw, 90vw"
                loading="lazy"
                format="webp"
              />
            </div>
            <figcaption class="shot-caption">
              <span>{v.caption}</span>
            </figcaption>
          </figure>
        </div>
      ))}
    </div>
  </section>
  <section class="section torn" id="features">
    <div class="wrap">
      <div class="section-heading" data-reveal>
        <div>
          <h2>
            Less fiddling.
            <br />
            More <em>“there it is.”</em>
          </h2>
        </div>
        <a class="text-link" href={url("features/")}>
          Explore every feature ↗
        </a>
      </div>
      <div class="feature-grid">
        <a
          class="feature-card"
          href={url("features/focused-writing/")}
          data-reveal
        >
          <span class="card-arrow" aria-hidden="true">
            ↗
          </span>
          <div class="feature-art">
            <Image
              src={featureIcons["focused-writing"]}
              alt=""
              widths={[150, 300]}
              sizes="150px"
            />
          </div>
          <h3>
            A quiet place
            <br />
            to get it down.
          </h3>
          <p>
            Focus mode, slash commands, and table tools. Room for the words.
          </p>
        </a>
        <a
          class="feature-card"
          href={url("features/math-and-diagrams/")}
          data-reveal
        >
          <span class="card-arrow" aria-hidden="true">
            ↗
          </span>
          <div class="feature-art">
            <Image
              src={featureIcons["math-and-diagrams"]}
              alt=""
              widths={[150, 300]}
              sizes="150px"
            />
          </div>
          <h3>
            For wonderfully
            <br />
            complicated ideas.
          </h3>
          <p>Math and Mermaid diagrams. Written as text, rendered live.</p>
        </a>
        <a
          class="feature-card"
          href={url("features/ai-assistant/")}
          id="ai"
          data-reveal
        >
          <span class="card-arrow" aria-hidden="true">
            ↗
          </span>
          <div class="feature-art">
            <Image
              src={featureIcons["ai-assistant"]}
              alt=""
              widths={[150, 300]}
              sizes="150px"
            />
          </div>
          <h3>
            A little assistance.
            <br />
            Your final say.
          </h3>
          <p>
            Optional AI. Review every suggested edit. Provider costs may apply.
          </p>
        </a>
      </div>
      <h3 class="toolkit-title" data-reveal>
        And a few more things in the box.
      </h3>
      <ul class="toolkit-grid">
        {toolkit.map((t) => (
          <li class="toolkit-item" data-reveal>
            <Image src={t.icon} alt="" widths={[64, 128]} sizes="64px" />
            <div>
              <h4>{t.name}</h4>
              <p>{t.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section wrap story-grid" id="open-source">
    <div data-reveal>
      <h2>
        Made for myself.
        <br />
        <em>Shared with you.</em>
      </h2>
      <p>
        “I built Paperling when I was starting my journey. I wanted an easier
        way to read .md files, so I made one for myself.”
      </p>
      <p>— Saqlain, creator of Paperling</p>
      <a class="text-link" href={url("open-source/")}>
        The story & the source ↗
      </a>
    </div>
    <div class="story-art" data-reveal>
      <Image
        class="story-mascot"
        src={mascotPaint}
        alt=""
        widths={[180, 360]}
        sizes="180px"
      />
      <div class="file-label">
        <span>~/a-few-good-ideas/</span>
        <span>↗</span>
      </div>
      <div class="file-art">
        <span>↳</span> the-next-big-thing.md
        <br />
        <span>↳</span> notes-to-self.md
        <br />
        <span>↳</span> a-small-discovery.md
        <br />
        <br />
        <small># A note to myself</small>
        <br />
        Good ideas need room.
        <br />
        <span>Not another login.</span>
      </div>
      <div class="note-callout">Yours to write. Yours to keep.</div>
    </div>
  </section>
  <section class="section compare-section" id="compare">
    <div class="wrap">
      <div class="section-heading" data-reveal>
        <div>
          <h2>
            Your editor.
            <br />
            <em>Your kind of thinking.</em>
          </h2>
        </div>
        <p>A few honest comparisons. Find what fits you.</p>
      </div>
      <div class="compare-links" data-reveal>
        {[
          ["obsidian", "Obsidian"],
          ["typora", "Typora"],
          ["vscode", "VS Code"],
          ["marktext", "MarkText"],
        ].map(([s, n]) => (
          <a href={url("compare/" + s + "/")}>
            vs {n}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section wrap faq-section" id="faq">
    <div data-reveal>
      <h2>
        Good questions.
        <br />
        <em>Straight answers.</em>
      </h2>
      <div class="actions">
        <a class="text-link" href={url("faq/")}>
          All questions & answers ↗
        </a>
      </div>
    </div>
    <Faq items={faqs.slice(0, 5)} />
  </section>
  <CTA />
</Base>
<script>
  const showcase = document.querySelector("[data-showcase]");
  if (showcase) {
    const tabs = [
      ...showcase.querySelectorAll<HTMLButtonElement>("[data-view-tab]"),
    ];
    const activate = (index: number) => {
      tabs.forEach((t, i) => {
        t.setAttribute("aria-selected", String(i === index));
        t.tabIndex = i === index ? 0 : -1;
      });
      showcase
        .querySelectorAll<HTMLElement>("[data-view-panel]")
        .forEach((p, i) => (p.hidden = i !== index));
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => activate(i));
      tab.addEventListener("keydown", (e) => {
        let next = i;
        if (e.key === "ArrowRight") next = (i + 1) % tabs.length;
        else if (e.key === "ArrowLeft")
          next = (i + tabs.length - 1) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        else return;
        e.preventDefault();
        activate(next);
        tabs[next].focus();
      });
    });
  }
</script>
