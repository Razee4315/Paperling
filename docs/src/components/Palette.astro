---
import { Image } from "astro:assets";
import { toolkit } from "../lib/art";
import { SITE } from "../lib/site";

// WEB-10: "what's in the box" is a working command palette, like the app's
// own. Type to filter; the list is plain content, so without JS every item
// is simply listed.
---

<div class="palette" data-palette data-reveal>
  <label class="bar">
    <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
      <circle
        cx="11"
        cy="11"
        r="6.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      ></circle>
      <path
        d="M16 16l4.5 4.5"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
    </svg>
    <input
      type="search"
      placeholder="Search what's in the box…"
      aria-label="Filter what's in the box"
      autocomplete="off"
      spellcheck="false"
      aria-controls="toolkit-list"
      data-palette-input
    />
    <kbd aria-hidden="true">/</kbd>
  </label>
  <ul class="list" id="toolkit-list">
    {toolkit.map((t) => (
      <li data-item data-search={(t.name + " " + t.text).toLowerCase()}>
        <Image src={t.icon} alt="" widths={[64, 128]} sizes="44px" />
        <div>
          <h4 data-name>{t.name}</h4>
          <p>{t.text}</p>
        </div>
      </li>
    ))}
  </ul>
  <p class="empty" data-empty hidden>
    Nothing called “<span data-query></span>” yet.
    <a href={SITE.repo + "/issues"} rel="noopener">
      Suggest it ↗
    </a>
  </p>
  <div class="foot">
    <span data-count aria-live="polite">
      {toolkit.length} things
    </span>
    <span class="hint" aria-hidden="true">
      <kbd>/</kbd> to search · <kbd>Esc</kbd> to clear
    </span>
  </div>
</div>

<style>
  .palette {
    max-width: 980px;
    margin-inline: auto;
    background: var(--surface);
    border: 1px solid #bec8b6;
    border-radius: 14px;
    box-shadow: 0 40px 80px -50px #12331e80;
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    cursor: text;
  }
  .bar input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--ink);
    font: 500 18px var(--sans);
  }
  .bar input::placeholder {
    color: #8a927f;
  }
  .bar input::-webkit-search-cancel-button {
    display: none;
  }
  .bar:focus-within {
    color: var(--green);
    box-shadow: inset 0 -2px 0 var(--green);
  }
  kbd {
    font: 11px var(--mono);
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 2px 7px;
    color: var(--muted);
    background: var(--paper);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 10px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px 10px;
  }
  .list li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 12px 14px;
    border-radius: 9px;
    transition: background 0.2s;
    animation: pop 0.35s cubic-bezier(0.34, 1.4, 0.64, 1) both;
  }
  .list li:hover,
  .list li.active {
    background: var(--sage);
  }
  .list li[hidden] {
    display: none;
  }
  .list img {
    flex: none;
    width: 44px;
    height: 44px;
    object-fit: contain;
    transition: transform 0.3s cubic-bezier(0.34, 1.6, 0.64, 1);
  }
  .list li:hover img,
  .list li.active img {
    transform: rotate(-8deg) scale(1.12);
  }
  .list h4 {
    margin: 0;
    font: 650 15px var(--display);
  }
  .list p {
    margin-top: 2px;
    font-size: 12.5px;
    line-height: 1.55;
  }
  .list :global(mark) {
    background: var(--gold);
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }
  .empty {
    padding: 34px 24px 40px;
    text-align: center;
    font-size: 15px;
  }
  .empty a {
    color: var(--green);
    border-bottom: 1px solid currentColor;
    margin-left: 6px;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    padding: 12px 24px;
    border-top: 1px solid var(--line);
    font: 11px var(--mono);
    color: var(--muted);
    background: #faf8f0;
  }
  .foot kbd {
    padding: 1px 5px;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }
  @media (max-width: 720px) {
    .list {
      grid-template-columns: 1fr;
      padding: 6px;
    }
    .bar {
      padding: 16px 18px;
    }
    .bar input {
      font-size: 16px;
    }
    .bar > kbd,
    .hint {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .list li {
      animation: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-palette]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("[data-palette-input]")!;
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const empty = root.querySelector<HTMLElement>("[data-empty]")!;
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const names = items.map((li) =>
      li.querySelector<HTMLElement>("[data-name]")!,
    );
    const labels = names.map((n) => n.textContent ?? "");
    const escape = (s: string) =>
      s.replace(
        /[&<>"]/g,
        (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!,
      );
    let active = -1;

    const setActive = (i: number) => {
      items.forEach((li) => li.classList.remove("active"));
      active = i;
      if (i >= 0) items[i].classList.add("active");
    };
    const filter = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((li, i) => {
        const hit = !q || li.dataset.search!.includes(q);
        li.hidden = !hit;
        if (hit) shown++;
        const label = labels[i];
        const at = q ? label.toLowerCase().indexOf(q) : -1;
        names[i].innerHTML =
          at < 0
            ? escape(label)
            : escape(label.slice(0, at)) +
              "<mark>" +
              escape(label.slice(at, at + q.length)) +
              "</mark>" +
              escape(label.slice(at + q.length));
      });
      empty.hidden = shown > 0;
      empty.querySelector("[data-query]")!.textContent = input.value.trim();
      count.textContent = q
        ? `${shown} of ${items.length}`
        : `${items.length} things`;
      const first = items.findIndex((li) => !li.hidden);
      setActive(q ? first : -1);
    };
    input.addEventListener("input", filter);
    input.addEventListener("keydown", (e) => {
      const visible = items
        .map((li, i) => (li.hidden ? -1 : i))
        .filter((i) => i >= 0);
      if (e.key === "Escape") {
        input.value = "";
        filter();
      } else if (
        (e.key === "ArrowDown" || e.key === "ArrowUp") &&
        visible.length
      ) {
        e.preventDefault();
        const pos = visible.indexOf(active);
        const step = e.key === "ArrowDown" ? 1 : -1;
        const next = visible[(pos + step + visible.length) % visible.length];
        setActive(next);
        items[next].scrollIntoView({ block: "nearest" });
      }
    });

    // "/" jumps into the palette while it's on screen, like the app's shortcut.
    let onScreen = false;
    new IntersectionObserver(([e]) => (onScreen = e.isIntersecting)).observe(
      root,
    );
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (
        e.key !== "/" ||
        !onScreen ||
        t.closest("input, textarea, [contenteditable]")
      )
        return;
      e.preventDefault();
      input.focus();
    });

    // Once, when it first scrolls into view, the palette types a query to
    // show what it does. Any interaction cancels it.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let cancelled = false;
      let typing = false;
      const cancel = () => {
        cancelled = true;
        if (typing) {
          typing = false;
          input.value = "";
          filter();
        }
      };
      input.addEventListener("focus", cancel);
      root.addEventListener("pointerdown", cancel);
      const demo = async () => {
        const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
        const word = "theme";
        await wait(700);
        if (cancelled) return;
        typing = true;
        for (let i = 1; i <= word.length && !cancelled; i++) {
          input.value = word.slice(0, i);
          filter();
          await wait(110);
        }
        await wait(1600);
        for (let i = word.length - 1; i >= 0 && !cancelled; i--) {
          input.value = word.slice(0, i);
          filter();
          await wait(60);
        }
        typing = false;
      };
      const io = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          io.disconnect();
          demo();
        },
        { threshold: 0.6 },
      );
      io.observe(root);
    }
  }
</script>
