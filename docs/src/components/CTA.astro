---
import { Image } from "astro:assets";
import { url } from "../lib/site";
import { mascotRocket } from "../lib/art";
---

<section class="cta-section" id="download">
  <div class="wrap">
    <span class="cta-spark" aria-hidden="true">
      ✳
    </span>
    <Image
      class="cta-mascot"
      src={mascotRocket}
      alt=""
      widths={[170, 340]}
      sizes="170px"
    />
    <h2>
      Your next big idea.
      <br />
      <em>Make room for it.</em>
    </h2>
    <a class="button" href={url("download/")}>
      Get Paperling. It's free. <span aria-hidden="true">↓</span>
    </a>
    <p class="fine">Windows · macOS · Linux · Android</p>
    <span class="cta-spark right" aria-hidden="true">
      ✳
    </span>
  </div>
</section>
