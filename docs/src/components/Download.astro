---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import sceneCelebration from "../assets/scenes/scene-celebration.png";
import qrDownload from "../assets/qr-download.svg";
import mobileReader from "../assets/screenshots/mobile-reader.png";
// Version for the APK filename shown in the install steps; same build-time
// source as Base.astro (repo-root package.json), so it tracks the shipped
// release automatically.
import { readFileSync } from "node:fs";
const pkg = JSON.parse(
  readFileSync(`${process.cwd()}/../package.json`, "utf-8"),
);

const releases = "https://github.com/Razee4315/Paperling/releases/latest";
const repo = "https://github.com/Razee4315/Paperling";
const version = pkg.version;

const platforms = [
  {
    icon: "simple-icons:windows10",
    os: "Windows",
    note: "Windows 10 / 11, 64-bit and ARM.",
    formats: ".exe installer · .msi",
    href: releases,
    cta: "Download for Windows",
    primary: true,
  },
  {
    icon: "simple-icons:linux",
    os: "Linux",
    note: "Debian/Ubuntu, Fedora, or any distro via AppImage.",
    formats: ".deb · .rpm · .AppImage",
    href: releases,
    cta: "Download for Linux",
    primary: true,
  },
  {
    icon: "simple-icons:apple",
    os: "macOS",
    note: "Apple Silicon and Intel, in one universal download.",
    formats: ".dmg",
    href: releases,
    cta: "Download for macOS",
    primary: true,
  },
  {
    icon: "simple-icons:android",
    os: "Android",
    note: "Fresh out of the oven: the full editor, rebuilt for touch. Android 10+ (arm64) phones.",
    formats: ".apk",
    href: releases,
    cta: "Get the Android APK",
    primary: false,
  },
];
---

<section id="download" class="relative overflow-hidden py-24 md:py-32">
  <div class="aurora" style="opacity:.3;height:60vh" data-parallax="5"></div>
  <div class="relative z-10 mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="mono-label justify-center"><span class="tok-mark">$</span> download</p>
      <h2 class="font-serif-display mt-3 text-[clamp(2.4rem,6vw,4rem)]">
        Get Paperling. It's free.
      </h2>
      <p class="mt-4 text-lg text-fg-muted">
        Free and open source. Grab the latest release for your platform. No account required.
      </p>
    </div>

    <!-- Confetti send-off: the mascot celebrating your download decision.
         Shown UNCROPPED: the scene's own paper background blends with the page. -->
    <div class="mx-auto mt-10 max-w-3xl" data-reveal>
      <Image
        src={sceneCelebration}
        alt="The Paperling mascot jumping with confetti and paper planes"
        widths={[760, 1100, 1600]}
        sizes="(max-width: 1024px) 100vw, 768px"
        loading="lazy"
        class="w-full rounded-2xl border border-line"
      />
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {platforms.map((p) => (
        <article class="card flex flex-col p-7" data-reveal>
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-line text-fg">
              <Icon name={p.icon} class="h-5 w-5" />
            </span>
            <h3 class="text-xl font-semibold">{p.os}</h3>
          </div>
          <p class="mt-4 flex-1 text-[15px] text-fg-muted">{p.note}</p>
          <a
            href={p.href}
            rel="noopener"
            class={`btn mt-6 w-full justify-center ${p.primary ? "btn-primary" : "btn-ghost"}`}
          >
            {p.cta}
          </a>
          <p class="mt-3 text-center text-xs text-fg-dim">{p.formats}</p>
        </article>
      ))}
    </div>

    <!-- Android launch band: real device screenshot + install steps + QR.
         The screenshot is captured from the actual app (mobile shell,
         Reader mode, 390x844) and framed in a phone bezel. -->
    <div class="mt-16 grid items-center gap-10 lg:grid-cols-2" data-reveal>
      <div class="mx-auto lg:mx-0">
        <div class="phone-frame">
          <div class="phone-screen">
            <Image
              src={mobileReader}
              alt="Paperling on Android: a note in Reader mode with headings, a task list and inline math"
              width={390}
              height={844}
              loading="lazy"
              class="block h-auto w-full select-none"
            />
          </div>
        </div>
      </div>
      <div>
        <p class="mono-label"><span class="tok-mark">></span> android</p>
        <h3 class="font-serif-display mt-3 text-[clamp(1.9rem,4vw,2.8rem)]">
          Now in your pocket.
        </h3>
        <p class="mt-4 text-[15px] leading-relaxed text-fg-muted">
          The whole editor — live preview, split view, math, diagrams, the AI
          panel, Zen mode — rebuilt around a thumb-first shell. Open
          <code class="rounded bg-bg-input px-1">.md</code> files straight from
          other apps with "Open with", export to HTML into your Downloads, and
          rely on the back button to close sheets before it ever risks your
          unsaved work.
        </p>
        <ol class="mt-6 space-y-2 text-[15px] text-fg-muted">
          <li><strong class="text-fg">1.</strong> Tap <em>Get the Android APK</em> above and grab <code class="rounded bg-bg-input px-1">Paperling_{version}_aarch64.apk</code>.</li>
          <li><strong class="text-fg">2.</strong> Allow "install unknown apps" for your browser once — normal for anything outside the Play Store.</li>
          <li><strong class="text-fg">3.</strong> Install. Updates install straight over the old version.</li>
        </ol>
        <div class="mt-7 flex items-center gap-5">
          <div class="qr-tile" title="Scan to download">
            <Image
              src={qrDownload}
              alt="QR code linking to the latest Paperling release"
              width={120}
              height={120}
              loading="lazy"
              class="h-28 w-28"
            />
          </div>
          <p class="max-w-[16rem] text-xs leading-relaxed text-fg-dim">
            Scan this with your phone to open the latest release page — the
            APK is attached under <strong>Assets</strong>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Phone bezel: the screenshot IS the screen (it already carries the
     app's own top bar and bottom nav), so the frame only adds the bezel. */
  .phone-frame {
    width: 264px;
    padding: 10px;
    border-radius: 36px;
    background: #2b2420;
    box-shadow:
      0 30px 60px -30px rgba(43, 36, 32, 0.55),
      inset 0 0 0 2px rgba(255, 255, 255, 0.06);
  }
  .phone-screen {
    overflow: hidden;
    border-radius: 27px;
    background: #fffdf9;
  }
  .qr-tile {
    display: inline-flex;
    padding: 8px;
    background: #fff;
    border: 1px solid var(--color-line, #e5ded2);
    border-radius: 14px;
    box-shadow: 0 10px 24px -18px rgba(43, 36, 32, 0.4);
  }
</style>
