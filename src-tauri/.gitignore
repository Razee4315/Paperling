# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas
# The whole generated Android/iOS project is CI-only (android-build.yml runs
# `tauri android init` fresh every build); every customization lives in
# tauri.conf.json / tauri.android.conf.json / the CI patch steps, because a
# hand-edit inside gen/ does not survive the next init.
/gen/android
/gen/apple
